pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
function _init()
  init_global_values()
 i = 0
end

function _update()
  -- move_car(car1, p)
end

function _update60()
end

function _draw()
  cls()
  if(scene==1) then
    print("start!")
  end
  if(scene==2) then
    print("middle!")
  end
  if(scene==3) then
    print("end!")
  end
  if(scene==4) then 
  print("debug--")

  move_car(car1)
  if (i < 250) then
    move_car(car2)
  end
  print('car:' ..car1.moves, 32, 60)
  print('car2:' ..car2.moves, 32, 70)
  i = i+1
  end
end 

function init_global_values() 
  scene = 4
  car1 = {
    { lx = 0, ly = 8 },
    { cx = 7, cy = 5 },
    { nx = 0, ny = 8 },
    fuel = 100,
    lap = 0,
    name = "ratson",
    id = 1,
    moves = 0,
    speed = 10,
    is_pitstop = false,
    in_pitlane = false,
    in_pitbox = false,
    tyre_wear = 100,
    d = 0,
    drive = { [0] = { 64, 66 }, { 68, 70 }, { 96, 98 }, { 100, 102 } },
    t, f, stp = 0, 1, 4, 
    spd = 5
  }

  -- lx, ly - last x, last y coordinate 
  -- cx, cy - current x, current y coordinate
  -- nx, ny - next x, next y coordinate
  car2 = {
    { lx = 0, ly = 8 },
    { cx = 7, cy = 5 },
    { nx = 0, ny = 8 },
    fuel = 10,
    lap = 0,
    name = "mellilot",
    id = 2,
    moves = 0,
    speed = 10,
    is_pitstop = false,
    in_pitlane = false,
    in_pitbox = false ,
    d = 0,
    drive = { [0] = { 72, 74 }, { 76, 78 }, { 104, 106 }, { 108, 110 } },
    t, f, stp = 0, 1, 4,
    spd = 5
  }
end

function move_car(car)
  pathfinding(car)
end

--used to take direction as a parameter which was p or o object (the entity of player or opponent secondary object)
function pathfinding(car)
  local next_step = {}
  local candidates = {}

  car[3]["nx"] = car[2]["cx"]
  car[3]["ny"] = car[2]["cy"]
  if first_move then
    car[1]["lx"] -= 1
    car[1]["ly"] = car[2]["cy"]
    first_move = false
    -- end
  end


  local neighbours = set_neighbours(car)

  for k, v in ipairs(neighbours) do
    for j, m in ipairs(v) do
      candidates[j] = m
    end
    if (candidates[1] != car[1]["lx"] or candidates[2] != car[1]["ly"]) then
      -- sfx(0)
      if can_move(candidates[1], candidates[2], car) then
        next_step[1] = candidates[1]
        next_step[2] = candidates[2]
        car["moves"] = car["moves"] + 1
      end
    end
  end

  car[1]["lx"] = car[2]["cx"]
  car[1]["ly"] = car[2]["cy"]

  car[2]["cx"] = next_step[1]
  car[2]["cy"] = next_step[2]

  local lx, ly = car[1]["lx"], car[1]["ly"]
  local cx, cy = car[2]["cx"], car[2]["cy"]

  -- set_direction(lx, ly, cx, cy, direction)
  -- sortleaderboard(leaderboard)
end
-- direction the car can move in 
--lx: last x co-ord
--ly: last y co-ord
--cx: current x co-ord
--cy: current y co-ord
--direction: direction of the sprite  
-- function set_direction(lx, ly, cx, cy, direction)
--   if (lx > cx) then
--     direction.d = 0
--   end
--   if (lx < cx) then
--     direction.d = 1
--   end
--   if (ly > cy) then
--     direction.d = 2
--   end
--   if (ly < cy) then
--     direction.d = 3
--   end
-- end

  function set_neighbours(car) -- dependency, it needs to move out of the pathfinding function 
    local up = {}
    local down = {}
    local left = {}
    local right = {}

    left[1] = car[3]["nx"] - 1
    left[2] = car[3]["ny"]
    right[1] = car[3]["nx"] + 1
    right[2] = car[3]["ny"]
    up[1] = car[3]["nx"]
    up[2] = car[3]["ny"] + 1
    down[1] = car[3]["nx"]
    down[2] = car[3]["ny"] - 1
    return { left, right, up, down }
  end


-- whether the car can move forward
function can_move(x, y, car)
  local map_sprite = mget(x, y)
  flag = fget(map_sprite)
  local computed_value = car.id + flag

  -- printh("Car:  " .. car["name"] .. " Flag: " .. flag .. " Computed Value: " .. computed_value, "petitprix_flag.txt", false, true)
  if (car["name"] == "ratson") then
    return computed_value != 2
  end
  if (car["name"] == "mellilot") then
    return computed_value != 3
  end
end

