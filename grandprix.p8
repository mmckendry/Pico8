pico-8 cartridge // http://www.pico-8.com
version 42
__lua__

 function _init()
  init_global_values()
  make_entities()
  init_leaderboard()
 end
 
 function _update()
  clearmessage()
  if(scene==0) then
   title_update()
  elseif (scene==1) then

  change_engine_mode()
  change_pace_mode()

  speed = calculate_speed(base_speed, engine_mode[engine_select][2], pace_mode[pace_select][2], tyre_compound.medium, tyre_wear)
  player.speed = speed
  if (tyre_wear != 0)then 
    tyre_wear = calculate_tyre_wear(tyre_compound.medium)
  end
  if (fuel != 0)then 
    fuel = calculate_fuel_burn()
  end

    move_player(player)
    if(player.in_pitbox) then 
      pitstop_update()
    end
  elseif(scene==2) then
   finish_update()
  end
  
 end
 
 function _draw()
  cls()
  if(scene==0) then
   title_draw()
  elseif(scene==1) then
    camera_follow()
    drawtrack()
    draw_opponent()
    draw_player()
    display_fuel()
    metrics()
    out_of_fuel()
    display_textwindow()
    if(player.in_pitbox) then
      pitstop_draw()
    end
  elseif(scene==2) then 
   finish_draw()
  end
end

function draw_player()
  palt(4,true)
  palt(0,false)
  anim_player(p)
  spr(p.drive[p.d][p.f],player[2]["cx"]*8,player[2]["cy"]*8,2,2)
end

function draw_opponent()
 anim_player(o)
 spr(o.drive[o.d][o.f],opponent[2]["cx"]*8,opponent[2]["cy"]*8,2,2)
end
